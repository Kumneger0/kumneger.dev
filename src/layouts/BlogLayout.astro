---
import { POST_METADATA, SITE_METADATA } from "@/consts";
import ScrollTopAndComments from "@/react/ScrollTopAndComments";
import { type CollectionEntry, getEntries, render } from "astro:content";
import AttachCopyAndProgressBar from "../components/AttachCopyAndProgressBar.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Link from "../components/Link.astro";
import PageTitle from "../components/PageTitle.astro";
import HireMeCTA from "../components/HireMeCTA.astro";
import PostCover from "../components/PostCover.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SocialShareButtons from "../components/social-icons/SocialShareButtons.astro";
import RootLayout from "./Layout.astro";

interface Props {
  post: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
  prev?: CollectionEntry<"blog">;
}

const { post, next, prev } = Astro.props as Props;
const authorRefs = (post.data.authors || []).map((a: any) =>
  typeof a === "string" ? { collection: "authors" as const, id: a } : a
).filter((a: any) => a && typeof a === "object" && a.id);

const tagRefs = (post.data.tags || []).map((t: any) =>
  typeof t === "string" ? { collection: "tags" as const, id: t } : t
).filter((t: any) => t && typeof t === "object" && t.id);

const authors = authorRefs.length
  ? (await getEntries(authorRefs)).filter((a): a is CollectionEntry<"authors"> => Boolean(a?.data))
  : [];
const tags = tagRefs.length
  ? (await getEntries(tagRefs)).filter((t): t is CollectionEntry<"tags"> => Boolean(t?.data))
  : [];

const articleOgDetails = {
  publishedTime: post.data.date,
  modifiedTime: post.data.lastmod,
  authors: authors.map(({ data }) => data.name),
  authorTwitter: authors.map(({ data }) => data.twitter).find(Boolean),
  tags: tags.map(({ data }) => data.name),
  cover: post.data.cover,
};

const { Content } = await render(post);
---

<RootLayout
  title={post.data.title}
  description={post.data.summary}
  article={articleOgDetails}
>
  <SectionContainer>
    <ScrollTopAndComments client:only="react" />
    <article>
      <header class="space-y-4 pb-8 pt-6 border-b border-gray-800/60">
        <div class="space-y-2">
          <div class="text-xs text-gray-500 font-mono">
            <FormattedDate date={post.data.date} />
          </div>
          <PageTitle>{post.data.title}</PageTitle>
        </div>
        {
          POST_METADATA.showSummary && post.data.summary && (
            <p class="text-base text-gray-400 leading-relaxed">{post.data.summary}</p>
          )
        }
      </header>

      {
        post.data.draft && (
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 dark:bg-yellow-500 dark:border-yellow-300 mt-10">
            <p class="leading-5 text-yellow-700 dark:text-yellow-300">
              This is a draft. It might be incomplete or have errors.
            </p>
          </div>
        )
      }

      <div>
        <div class="prose dark:prose-invert max-w-full pt-6 pb-8">
          <slot />
          <Content />
        </div>

        <!-- <HireMeCTA /> -->

        {
          ["bottom", "both"].includes(POST_METADATA.showShareButtons) ? (
            <SocialShareButtons
              title={post.data.title}
              description={post.data.summary}
            />
          ) : null
        }

        <div class="giscus-comments mt-12 pt-8 border-t border-gray-800/60">
          <div class="giscus"></div>
        </div>

        <script is:inline>
          function loadGiscus() {
            const container = document.querySelector('.giscus');
            if (!container) return;
            container.innerHTML = '';
            const script = document.createElement('script');
            script.src = 'https://giscus.app/client.js';
            script.setAttribute('data-repo', 'Kumneger0/kumneger.dev');
            script.setAttribute('data-repo-id', 'R_kgDOMDEaXQ');
            script.setAttribute('data-category', 'Ideas');
            script.setAttribute('data-category-id', 'DIC_kwDOMDEaXc4CmR_P');
            script.setAttribute('data-mapping', 'pathname');
            script.setAttribute('data-strict', '0');
            script.setAttribute('data-reactions-enabled', '1');
            script.setAttribute('data-emit-metadata', '1');
            script.setAttribute('data-input-position', 'top');
            script.setAttribute('data-theme', 'transparent_dark');
            script.setAttribute('data-lang', 'en');
            script.setAttribute('crossorigin', 'anonymous');
            script.async = true;
            container.appendChild(script);
          }

          loadGiscus();
          document.addEventListener('astro:page-load', loadGiscus);
        </script>

        <footer
          class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-700"
        >
          <div
            class="flex flex-col text-sm font-medium sm:flex-row sm:justify-between sm:text-base"
          >
            {
              prev && (
                <div class="pt-4 xl:pt-8">
                  <Link
                    href={`/${prev.id}`}
                    class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                    aria-label={`Previous post: ${prev.data.title}`}
                  >
                    &larr; {prev.data.title}
                  </Link>
                </div>
              )
            }
            {
              next && (
                <div class="pt-4 xl:pt-8">
                  <Link
                    href={`/${next.id}`}
                    class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                    aria-label={`Next post: ${next.data.title}`}
                  >
                    {next.data.title} &rarr;
                  </Link>
                </div>
              )
            }
          </div>
        </footer>
      </div>
    </article>
  </SectionContainer>
</RootLayout>
<AttachCopyAndProgressBar />
