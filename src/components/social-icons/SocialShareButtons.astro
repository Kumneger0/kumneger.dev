---
import FacebookShareButton from "./social-buttons/FacebookShareButton.astro";
import LinkedInShareButton from "./social-buttons/LinkedInShareButton.astro";
import RedditShareButton from "./social-buttons/RedditShareButton.astro";
import TwitterShareButton from "./social-buttons/TwitterShareButton.astro";

type Props = {
  title: string;
  description: string;
  via?: string;
  class?: string;
};

const { title, description, via } = Astro.props;
---

<div class="flex items-center gap-4" class:list={Astro.props.class}>
  <FacebookShareButton />
  <LinkedInShareButton />
  <RedditShareButton {title} />
  <TwitterShareButton {description} {via} />
  <span class="ml-2 text-sm italic text-gray-400 dark:text-gray-500">
    sharing is caring
  </span>
</div>

<style>
  :global(.social-share-btn) {
    width: 24px;
    height: 24px;
  }
</style>
