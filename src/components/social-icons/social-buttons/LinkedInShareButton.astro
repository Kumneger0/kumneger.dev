---
import LinkedinIcon from "../icons/Linkedin.astro";

const URL = `https://www.linkedin.com/sharing/share-offsite/?url=${Astro.request.url}`;
---

<a
  class="social-share-btn text-gray-500 dark:text-gray-400 hover:text-[#0a66c2] transition-colors"
  target="_blank"
  href={URL}
  rel="noopener noreferrer"
>
  <LinkedinIcon />
</a>
