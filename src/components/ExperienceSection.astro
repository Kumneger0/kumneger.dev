---
---

<section class="py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="flex items-center gap-3 mb-10">
      <span class="font-mono text-xs text-terminal-accent tracking-wider">03</span>
      <h2 class="text-2xl font-bold text-terminal-text">Experience</h2>
      <div class="flex-1 h-px bg-terminal-border"></div>
    </div>

    <div class="space-y-6">
      <!-- Work -->
      <div class="rounded-xl border border-terminal-border bg-terminal-surface/50 p-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <span class="font-mono text-[10px] text-terminal-accent tracking-[0.2em] uppercase block mb-1">WORK</span>
            <h3 class="text-lg font-bold text-terminal-text">Full-Stack Developer</h3>
            <p class="text-sm text-terminal-muted">
              <a href="https://2f-capital.com/" target="_blank" rel="noopener noreferrer" class="text-terminal-accent hover:underline">2F Capital</a>
            </p>
          </div>
          <span class="font-mono text-xs text-terminal-muted shrink-0">Aug 2024 – Present</span>
        </div>
        <p class="text-terminal-muted text-sm leading-relaxed mb-4">
          I work as a full-stack developer at 2F Capital, mainly using Next.js and TypeScript. I also work with tools and frameworks like NestJS, depending on the project.
        </p>
        <div class="flex flex-wrap gap-2">
          {["Next.js", "React", "TypeScript", "NestJS", "Node.js"].map((tech) => (
            <span class="font-mono text-[11px] px-2.5 py-1 rounded-md bg-terminal-accent/5 text-terminal-accent/80 border border-terminal-accent/10">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Education -->
      <div class="rounded-xl border border-terminal-border bg-terminal-surface/50 p-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <span class="font-mono text-[10px] text-terminal-accent tracking-[0.2em] uppercase block mb-1">EDUCATION</span>
            <h3 class="text-lg font-bold text-terminal-text">BSc in Computer Science</h3>
            <p class="text-sm text-terminal-muted">
              <a href="https://www.ju.edu.et/" target="_blank" rel="noopener noreferrer" class="text-terminal-accent hover:underline">Jimma University</a>
            </p>
          </div>
          <span class="font-mono text-xs text-terminal-muted shrink-0">2019 – 2024</span>
        </div>
      </div>
    </div>
  </div>
</section>
