---
import { SITE_METADATA } from "@/consts";
import Link from "./Link.astro";
---

<div
  class="my-8 rounded-lg border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800 text-center"
>
  <h3 class="mt-0 text-xl font-bold text-gray-900 dark:text-gray-100">
    Want to hire me?
  </h3>
  <p class="mt-2 text-gray-700 dark:text-gray-300 mb-4">
    I am currently open to new opportunities and collaborations. If you have a
    project in mind or just want to say hi, feel free to reach out!
  </p>
  <Link
    href={`mailto:${SITE_METADATA.email}`}
    class="inline-block rounded bg-primary-500 px-4 py-2 mt-3 font-medium text-white hover:bg-primary-600 dark:hover:bg-primary-400 no-underline"
  >
    Get in touch &rarr;
  </Link>
</div>
