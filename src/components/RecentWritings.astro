---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="flex items-center gap-3 mb-10">
      <span class="font-mono text-xs text-terminal-accent tracking-wider">04</span>
      <h2 class="text-2xl font-bold text-terminal-text">Recent Writings</h2>
      <div class="flex-1 h-px bg-terminal-border"></div>
    </div>

    <div class="space-y-1">
      {posts.map((post) => (
        <a
          href={`/writings/${post.id}`}
          class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 py-4 -mx-3 px-3 rounded-lg hover:bg-terminal-surface/80 transition-colors duration-200 no-underline"
        >
          <span class="font-mono text-xs text-terminal-muted shrink-0 tabular-nums">
            <FormattedDate date={post.data.date} />
          </span>
          <span class="text-terminal-text group-hover:text-terminal-accent transition-colors duration-200">
            {post.data.title}
          </span>
        </a>
      ))}
    </div>

    <div class="mt-8">
      <a
        href="/writings"
        class="inline-flex items-center gap-2 text-sm text-terminal-muted hover:text-terminal-accent transition-colors duration-200"
      >
        View all writings
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
