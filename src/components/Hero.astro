---
import { SITE_METADATA } from "@/consts";
---

<section class="py-16 md:py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <p class="font-mono text-xs text-terminal-muted mb-6 tracking-wider uppercase">// hello world</p>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight tracking-tight text-terminal-text mb-6">
      Yet another guy from Ethiopia who loves building stuff on the internet.
    </h1>
    <p class="text-lg text-terminal-muted leading-relaxed max-w-2xl mb-8">
      Full-stack developer at 2F Capital. Mostly TypeScript and Go. Sometimes I build things just to see if I can.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="#work"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-terminal-accent/10 text-terminal-accent border border-terminal-accent/20 font-medium text-sm hover:bg-terminal-accent/20 transition-colors duration-200 no-underline"
      >
        Explore my work
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-terminal-muted border border-terminal-border font-medium text-sm hover:text-terminal-text hover:border-terminal-muted transition-colors duration-200 no-underline"
      >
        Get in touch
      </a>
    </div>
  </div>
</section>
