---
import { SITE_METADATA } from "@/consts";
---

<section id="contact" class="py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="rounded-xl border border-terminal-border bg-terminal-surface/50 p-8 md:p-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-terminal-text mb-4">
        Got something interesting to build?
      </h2>
      <p class="text-terminal-muted leading-relaxed max-w-lg mx-auto mb-8">
        I'm always happy to hear about interesting projects, opportunities, or ideas.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={`mailto:${SITE_METADATA.email}`}
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-terminal-accent/10 text-terminal-accent border border-terminal-accent/20 font-medium text-sm hover:bg-terminal-accent/20 transition-colors duration-200 no-underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Send an email
        </a>
        <a
          href={SITE_METADATA.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-terminal-muted border border-terminal-border font-medium text-sm hover:text-terminal-text hover:border-terminal-muted transition-colors duration-200 no-underline"
        >
          GitHub
        </a>
        <a
          href={SITE_METADATA.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-terminal-muted border border-terminal-border font-medium text-sm hover:text-terminal-text hover:border-terminal-muted transition-colors duration-200 no-underline"
        >
          Twitter/X
        </a>
        <a
          href={SITE_METADATA.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-terminal-muted border border-terminal-border font-medium text-sm hover:text-terminal-text hover:border-terminal-muted transition-colors duration-200 no-underline"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
