---
const projects = [
  {
    label: "TELEGRAM, BUT IN MY TERMINAL",
    title: "Cligram",
    description: "I wanted to use Telegram without leaving the terminal, so I built my own client.",
    context: "What started as a simple idea grew into a Telegram client with features like ghost mode, letting me read messages and view stories more discreetly.",
    tech: ["Go"],
    links: {
      github: "https://github.com/Kumneger0/cligram",
      docs: "https://cligram.kumneger.dev",
    },
  },
  {
    label: "MUSIC WITHOUT THE GUI",
    title: "yt-tracks",
    description: "I love listening to music. I just don't always want to open a GUI to do it.",
    context: "So I built yt-tracks, a terminal music player that lets me listen to music without leaving the command line.",
    tech: ["Go", "Python"],
    links: {
      github: "https://github.com/Kumneger0/yt-tracks",
      docs: "https://ytmusic-tui.kumneger.dev/",
    },
  },
  {
    label: "TURNING TELEGRAM INTO STORAGE",
    title: "TGCloud",
    description: "I wanted somewhere to store my files without constantly worrying about running out of space.",
    context: "That led me to TGCloud, a personal cloud storage project built around using Telegram as the foundation for storing files.",
    tech: ["Next.js"],
    links: {
      live: "https://yourtgcloud.vercel.app/",
    },
  },
];
---

<section id="work" class="py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="flex items-center gap-3 mb-10">
      <span class="font-mono text-xs text-terminal-accent tracking-wider">01</span>
      <h2 class="text-2xl font-bold text-terminal-text">Featured Projects</h2>
      <div class="flex-1 h-px bg-terminal-border"></div>
    </div>

    <div class="space-y-6">
      {projects.map((project, i) => (
        <div class="group rounded-xl border border-terminal-border bg-terminal-surface/50 p-6 hover:border-terminal-accent/30 transition-colors duration-300">
          <div class="flex flex-col gap-4">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <span class="font-mono text-[10px] text-terminal-accent tracking-[0.2em] uppercase block mb-2">{project.label}</span>
                <h3 class="text-xl font-bold text-terminal-text mb-2">{project.title}</h3>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                {project.links.github && (
                  <a
                    href={project.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-lg text-terminal-muted hover:text-terminal-accent hover:bg-terminal-accent/10 transition-colors duration-200"
                    aria-label={`${project.title} on GitHub`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  </a>
                )}
                {(project.links.docs || project.links.live) && (
                  <a
                    href={project.links.docs || project.links.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-lg text-terminal-muted hover:text-terminal-accent hover:bg-terminal-accent/10 transition-colors duration-200"
                    aria-label={`${project.title} ${project.links.docs ? 'documentation' : 'live demo'}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <p class="text-terminal-muted leading-relaxed">{project.description}</p>
            <p class="text-sm text-terminal-muted/80 leading-relaxed">{project.context}</p>

            <div class="flex flex-wrap gap-2 pt-1">
              {project.tech.map((t) => (
                <span class="font-mono text-[11px] px-2.5 py-1 rounded-md bg-terminal-accent/5 text-terminal-accent/80 border border-terminal-accent/10">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href="https://github.com/Kumneger0"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-terminal-muted hover:text-terminal-accent transition-colors duration-200"
      >
        See more on GitHub
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
