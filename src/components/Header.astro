---
import { NAVIGATION } from "@/consts";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
---

<header
  transition:persist
  class="flex items-center justify-between py-10 max-w-3xl px-4 mx-auto sm:px-6 w-full"
>
  <div class="mr-3 shrink-0">
    <a href="/" aria-label={"Kumneger Wondimu"} class="no-underline">
      <Logo />
    </a>
  </div>
  <div class="flex items-center leading-5 space-x-4">
    {
      NAVIGATION.filter((link) => link.href !== "/").map((link) => (
        <HeaderLink
          href={link.href}
          class="block font-medium text-gray-900 dark:text-gray-100"
        >
          {link.title}
        </HeaderLink>
      ))
    }
  </div>
</header>
