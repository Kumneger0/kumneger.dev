---
import { NAVIGATION } from "@/consts";
import Logo from "./Logo.astro";
---

<header
  transition:persist
  class="border-b border-terminal-border/50 bg-terminal-bg/80 backdrop-blur-sm sticky top-0 z-50"
>
  <div class="flex items-center justify-between py-4 max-w-3xl px-4 mx-auto sm:px-6 w-full">
    <div class="mr-3 shrink-0">
      <a href="/" aria-label="Kumneger Wondimu" class="no-underline">
        <Logo />
      </a>
    </div>
    <nav class="flex items-center gap-1">
      {
        NAVIGATION.filter((link) => link.href !== "/").map((link) => (
          <a
            href={link.href}
            class="px-3 py-1.5 rounded-md text-sm font-medium text-terminal-muted hover:text-terminal-text hover:bg-terminal-surface transition-colors duration-200 no-underline"
          >
            {link.title}
          </a>
        ))
      }
    </nav>
  </div>
</header>
