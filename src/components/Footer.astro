---
import { getEntry } from "astro:content";

const author = await getEntry("authors", "default");
---

<footer class="border-t border-terminal-border/50 py-8">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-mono text-xs text-terminal-muted">
        © {new Date().getFullYear()} Kumneger Wondimu
      </p>
      <div class="flex items-center gap-4">
        <a
          href={author?.data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-terminal-muted hover:text-terminal-accent transition-colors duration-200"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
        <a
          href={author?.data.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="text-terminal-muted hover:text-terminal-accent transition-colors duration-200"
          aria-label="Twitter"
        >
          <svg fill="none" height="18" width="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
            <path d="M0 0h512v512H0z" fill="currentColor"></path>
            <path clip-rule="evenodd" d="M192.034 98H83l129.275 170.757L91.27 412h55.908l91.521-108.34 81.267 107.343H429L295.968 235.284l.236.303L410.746 99.994h-55.908l-85.062 100.694zm-48.849 29.905h33.944l191.686 253.193h-33.944z" fill="#080a08" fill-rule="evenodd"></path>
          </svg>
        </a>
        <a
          href={author?.data.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-terminal-muted hover:text-terminal-accent transition-colors duration-200"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6M2 9h4v12H2z" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
        <a
          href={author?.data.bluesky}
          target="_blank"
          rel="noopener noreferrer"
          class="text-terminal-muted hover:text-terminal-accent transition-colors duration-200"
          aria-label="Bluesky"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -3.268 64 68.414" width="18" height="18">
            <path fill="currentColor" d="M13.873 3.805C21.21 9.332 29.103 20.537 32 26.55v15.882c0-.338-.13.044-.41.867-1.512 4.456-7.418 21.847-20.923 7.944-7.111-7.32-3.819-14.64 9.125-16.85-7.405 1.264-15.73-.825-18.014-9.015C1.12 23.022 0 8.51 0 6.55 0-3.268 8.579-.182 13.873 3.805zm36.254 0C42.79 9.332 34.897 20.537 32 26.55v15.882c0-.338.13.044.41.867 1.512 4.456 7.418 21.847 20.923 7.944 7.111-7.32 3.819-14.64-9.125-16.85 7.405 1.264 15.73-.825 18.014-9.015C62.88 23.022 64 8.51 64 6.55c0-9.818-8.578-6.732-13.873-2.745z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
