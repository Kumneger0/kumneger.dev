---
import { type CollectionEntry, getCollection } from "astro:content";

import Link from "@/components/Link.astro";
import Tag from "@/components/Tag.astro";
import RootLayout from "@/layouts/Layout.astro";

const tags = await getCollection("tags");
const posts = await getCollection("blog");

export const prerender = true;

function tagCount(slug: CollectionEntry<"tags">["id"]) {
  if (!posts) return 0;
  return posts.filter((post) => post.data.tags.some((tag) => tag.id === slug))
    .length;
}

const sortedTags = [...tags]
  .filter((tag) => tagCount(tag.id) > 0)
  .sort((a, b) => {
    const countA = tagCount(a.id);
    const countB = tagCount(b.id);
    return countB - countA;
  });
---

<RootLayout title={"Tags"} description={"All tags used in the blog"}>
  <div class="w-3xl mx-auto px-4 sm:px-6 py-10">
    <div class="space-y-2 pb-8 pt-6 md:space-y-5 text-center">
      <h1
        class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14"
      >
        All Tags
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Browse articles by topic
      </p>
    </div>

    <div class="divide-y divide-gray-800/60 mt-6">
      {
        !sortedTags.length && (
          <div class="text-center py-10">
            <p class="text-lg text-gray-400">
              No tags found
            </p>
          </div>
        )
      }

      {
        sortedTags.map((tag) => {
          const count = tagCount(tag.id);
          return (
            <Link
              href={`/tags/${tag.id}`}
              class="group flex items-center justify-between py-4 transition-colors"
            >
              <div>
                <span class="text-base font-medium font-mono text-gray-100 group-hover:text-gray-300">
                  #{tag.id}
                </span>
                {tag.data.description && (
                  <p class="text-sm text-gray-400 font-sans mt-0.5">
                    {tag.data.description}
                  </p>
                )}
              </div>
              <span class="text-xs font-mono text-gray-500 shrink-0 ml-4">
                {count} {count === 1 ? "writing" : "writings"}
              </span>
            </Link>
          );
        })
      }
    </div>
  </div>
</RootLayout>
