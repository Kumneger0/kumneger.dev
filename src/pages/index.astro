---
import RootLayout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import AboutSection from "../components/AboutSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import RecentWritings from "../components/RecentWritings.astro";
import ContactSection from "../components/ContactSection.astro";
import Terminal from "../components/Terminal.astro";
import { SITE_METADATA } from "@/consts";
---

<RootLayout title={SITE_METADATA.title} description={SITE_METADATA.description}>
  <main>
    <Hero />
    <FeaturedProjects />
    <AboutSection />
    <ExperienceSection />
    <RecentWritings />
    <ContactSection />
    <Terminal />
  </main>
</RootLayout>
